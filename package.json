{
	"name": "video-uploader",
	"version": "1.0.0",
	"description": "A project that for now is going to be design for my own local use case. It will automatically upload a Youtube video from an archive on a schedule.",
	"main": "index.js",
	"type": "module",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"run-once": "tsx src/index.ts run-once",
		"build": "tsc",
		"start": "node dist/index.js",
		"typecheck": "tsc -p tsconfig.check.json",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest run --passWithNoTests",
		"test:watch": "vitest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/neekekul/video-uploader.git"
	},
	"keywords": [],
	"bugs": {
		"url": "https://github.com/neekekul/video-uploader/issues"
	},
	"homepage": "https://github.com/neekekul/video-uploader#readme",
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@types/node": "^26.6.6",
		"@types/yauzl": "^3.4.0",
		"@types/yazl": "^3.3.1",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.1.1",
		"yazl": "^3.3.1"
	},
	"dependencies": {
		"croner": "^11.0.1",
		"tar": "^7.5.23",
		"yaml": "^2.9.1",
		"yauzl": "^3.4.0",
		"zod": "^4.6.7"
	}
}
