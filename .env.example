# Copy to .env and adjust. Real environment variables take precedence.

# Folder containing inbox/, processing/, done/, failed/ and work/ (created if missing).
DROP_DIR=./drop

# Folder containing description-header.txt and description-footer.txt.
CONFIG_DIR=./config

# Cron expression for scheduled runs (default: every 2 hours).
SCHEDULE=0 */2 * * *

# Also run immediately when the app starts.
RUN_ON_START=true

# Seconds an inbox file must stay unchanged before it is treated as fully copied.
STABILITY_WAIT_SECONDS=10

# Attempts per archive before it goes to failed/ (first try + retries).
MAX_ATTEMPTS=2

# Comma-separated platforms used when an archive's metadata doesn't list any.
# Use dry-run to test archives without uploading anything.
PLATFORMS=youtube

# OAuth "Desktop app" client JSON from Google Cloud Console.
YOUTUBE_CLIENT_SECRET_FILE=./credentials/youtube-client-secret.json

# Refresh token written by `npm run auth:youtube`.
YOUTUBE_TOKEN_FILE=./credentials/youtube-token.json
